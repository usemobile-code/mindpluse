{
  "entities": {
    "UserAssessment": {
      "path": "users/{userId}/assessments/{assessmentId}",
      "description": "User mental stress assessment records isolated by user ID with zero cross-user leakage.",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" },
        "score": { "type": "number" },
        "baseScore": { "type": "number" },
        "appliedMoodModifier": { "type": "number" },
        "tier": { "type": "string" },
        "emoji": { "type": "string" },
        "categoryScores": { "type": "map" },
        "answers": { "type": "map" },
        "recommendations": { "type": "map" },
        "syncedToCloud": { "type": "boolean" }
      }
    },
    "UserJournal": {
      "path": "users/{userId}/journal_sessions/{sessionId}",
      "description": "User mindful journaling sessions and AI reflections isolated by user ID.",
      "fields": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "messages": { "type": "list" },
        "syncedToCloud": { "type": "boolean" }
      }
    },
    "UserDailyMood": {
      "path": "users/{userId}/daily_moods/{moodId}",
